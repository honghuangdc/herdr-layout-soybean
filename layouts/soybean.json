{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 40
          },
          "window_drag": true
        },
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "agentee-spaces"
          },
          "size": {
            "weight": 2
          },
          "min": 90
        },
        {
          "id": "agents",
          "type": "block",
          "content": {
            "mod": "agentee-agents-list"
          },
          "size": {
            "weight": 1
          },
          "min": 90
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "agentee-chrome",
            "props": {
              "role": "footer"
            }
          },
          "size": {
            "px": 40
          }
        }
      ],
      "size": {
        "px": 256
      },
      "min": 44,
      "max": 420,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "soybean-tabs",
            "props": {
              "browser": "/Users/soybean/.local/bin/herdr-browser-split"
            }
          },
          "size": {
            "px": 38
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane-chat"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#3d3d3d"
                  },
                  "radius": 8,
                  "gap": 6,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "panel-files",
                      "type": "block",
                      "content": {
                        "mod": "file-icons"
                      }
                    },
                    {
                      "id": "panel-gh",
                      "type": "block",
                      "content": {
                        "mod": "github"
                      }
                    }
                  ],
                  "active": "panel-files"
                }
              ],
              "size": {
                "px": 360
              },
              "min": 260,
              "max": 760,
              "background": "chrome"
            }
          ],
          "padding": 6,
          "gap": 6
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "agentee-status"
          },
          "size": {
            "px": 40
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "theme": "agentee",
  "font": "JetBrains Mono",
  "font_size": 13,
  "ui_font": "Geist",
  "terminal_padding": [
    8,
    10
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "movable": true,
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
